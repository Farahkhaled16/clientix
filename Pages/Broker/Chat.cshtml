@page "/Broker/Chat"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "broker")]
@model BrokerHub.Pages.Broker.ChatModel
@inject BrokerHub.Services.Translator T

<section class="hero" style="padding-bottom:10px">
    <h1>@T["bk.chat"]</h1>
</section>

<div class="chat-layout @(Model.Current != null ? "open" : "")">
    <aside class="panel chat-list">
        @if (!Model.Threads.Any())
        {
            <p class="muted">@T["bk.chat.none"]</p>
        }
        <ul id="threadList" class="threads">
            @foreach (var t in Model.Threads)
            {
                var ini = t.BusinessName.Length > 0 ? t.BusinessName.Substring(0, 1) : "?";
                <li data-id="@t.Id" class="@(Model.Current?.Id == t.Id ? "active" : "")">
                    <a href="/Broker/Chat?thread=@t.Id">
                        <span class="avatar sm">@ini</span>
                        <span class="t-info"><b>@t.BusinessName</b><span class="last">@t.LastText</span></span>
                        @if (t.UnreadForBroker > 0)
                        {
                            <span class="unread-badge">@t.UnreadForBroker</span>
                        }
                    </a>
                </li>
            }
        </ul>
    </aside>

    @if (Model.Current == null)
    {
        <div class="chat-shell"><p class="chat-empty" style="margin:auto">@T["bk.chat.pick"]</p></div>
    }
    else
    {
        <div id="chatRoot" class="chat-shell" data-thread="@Model.Current.Id"
             data-t-view="@T["chat.viewagency"]" data-t-file="@T["chat.file"]" data-t-uploading="@T["chat.uploading"]"
             data-t-fail="@T["chat.uploadfail"]" data-t-toobig="@T["chat.toobig"]" data-t-empty="@T["chat.empty"]">
            <div class="chat-head">
                <a class="back-link" href="/Broker/Chat"><span class="back-arrow">←</span></a>
                <div class="avatar sm">@(Model.Current.BusinessName.Length > 0 ? Model.Current.BusinessName.Substring(0, 1) : "?")</div>
                <div>
                    <b>@Model.Current.BusinessName</b>
                    <span id="chatStatus" class="status" data-on="@T["chat.online"]" data-off="@T["chat.connecting"]">@T["chat.connecting"]</span>
                </div>
            </div>

            <div id="chatLog" class="chat-log"></div>

            <div id="typingBar" class="typing" hidden>
                <span class="dots"><i></i><i></i><i></i></span><span>@T["chat.typing.client"]</span>
            </div>

            <form id="chatForm" class="chat-form">
                <input id="chatFile" type="file" hidden accept="image/*,video/*,.pdf,.doc,.docx,.ppt,.pptx" />
                <button id="attachBtn" class="icon-btn" type="button" aria-label="@T["chat.attach"]">📎</button>
                <button id="agencyBtn" class="icon-btn" type="button" aria-label="@T["chat.pickagency"]">🏢</button>
                <textarea id="chatInput" rows="1" placeholder="@T["chat.placeholder"]"></textarea>
                <button class="btn" type="submit">@T["chat.send"]</button>
            </form>
        </div>

        <div id="agencyPicker" class="modal" hidden>
            <div class="modal-card">
                <div class="modal-head">
                    <b>@T["chat.pickagency"]</b>
                    <button type="button" class="icon-btn" data-close aria-label="Close">✕</button>
                </div>
                <input type="search" placeholder="@T["search.ph"]" />
                <div class="pk-list"></div>
            </div>
        </div>

        <script type="application/json" id="chatInit">@Html.Raw(Model.InitJson)</script>
    }
</div>

@section Scripts {
    <script src="~/js/chat.js" asp-append-version="true"></script>
}