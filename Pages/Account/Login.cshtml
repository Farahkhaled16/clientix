@page
@model BrokerHub.Pages.Account.LoginModel
@inject BrokerHub.Services.Translator T

<div class="form-box">
    <h1>@T["auth.login"]</h1>

    @if (Model.Role == "agency")
    {
        <p class="form-link" style="margin-top:-8px">@T["auth.agencynote"]</p>
    }

    @if (Model.Error != null) { <div class="alert">@T[Model.Error]</div> }
    @if (Model.Info != null) { <div class="alert ok">@T[Model.Info]</div> }

    <form method="post">
        <input type="hidden" name="role" value="@Model.Role" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <label>@T["auth.email"]</label>
        <input type="text" name="email" value="@Model.PendingEmail" required />
        <label>@T["auth.password"]</label>
        <input type="password" name="password" required />
        <button class="btn" type="submit">@T["auth.login"]</button>
    </form>

    @if (Model.ShowResend)
    {
        <form method="post" asp-page-handler="Resend">
            <input type="hidden" name="role" value="@Model.Role" />
            <input type="hidden" name="email" value="@Model.PendingEmail" />
            <button class="btn btn-light" type="submit">@T["auth.resend"]</button>
        </form>
    }

    <p class="form-link"><a href="/Account/Forgot">@T["auth.forgot"]</a></p>

    @if (Model.Role != "agency")
    {
        <div class="divider"><span>@T["auth.or"]</span></div>
        <a class="btn btn-google"
           href="/google-login?role=@Model.Role&returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">
            @T["auth.google"]
        </a>

        <p class="form-link">
            @T["auth.noaccount"]
            <a href="/Account/Register?role=@Model.Role&returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">@T["auth.register"]</a>
        </p>
    }
</div>