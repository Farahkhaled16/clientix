@page
@model IndexModel
@inject BrokerHub.Services.Translator T

<section class="hero-stack">
    <div class="hero-panel">
        <h1>@T["hero.title"]</h1>
        <p>@T["hero.subtitle"]</p>
    </div>
</section>

<section class="role-grid">
    <div class="role-card">
        <div class="role-icon">🏢</div>
        <h2>@T["role.business"]</h2>
        <p>@T["role.business.desc"]</p>
        <a class="btn" href="/Agencies">@T["btn.continue"]</a>
    </div>

    <div class="role-card alt">
        <div class="role-icon">📣</div>
        <h2>@T["role.agency"]</h2>
        <p>@T["role.agency.desc"]</p>
        <a class="btn btn-white" href="/Account/Login?role=agency">@T["btn.continue"]</a>
    </div>
</section>